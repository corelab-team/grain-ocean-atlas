{
  "name": "grain-export-atlas",
  "version": "1.0.8",
  "private": true,
  "description": "Автономные маршруты экспорта зерна для Windows",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "verify:assets": "node electron/verify-assets.cjs",
    "prestart": "pnpm verify:assets",
    "start": "electron .",
    "start:windowed": "electron . --windowed",
    "test": "node --test electron/files.test.cjs",
    "test:electron": "node electron/smoke.cjs",
    "pack:win": "pnpm verify:assets && electron-builder --win --x64 --dir --publish never",
    "dist:win": "pnpm verify:assets && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "ru.corelab.grain-ocean-atlas.export",
    "productName": "Grain Export Atlas",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/files.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/export-only",
        "to": "atlas",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "GrainExportAtlas",
      "signAndEditExecutable": false,
      "artifactName": "GrainExportAtlas-${version}-win-${arch}.${ext}"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Маршруты экспорта",
      "runAfterFinish": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "artifactName": "GrainExportAtlas-${version}-win-${arch}-Setup.${ext}"
    }
  }
}
